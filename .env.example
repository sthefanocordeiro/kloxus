# Kloxus configuration — real mode only.
# Demo mode (kloxus demo) runs fully offline and needs none of this.
# Copy to .env and fill in. Never commit .env.

# --- Server ---
KLOXUS_PORT=8080
# Interface the HTTP listener binds to. The 127.0.0.1 default keeps local
# dev/test runs off the firewall's radar; the Fly image sets 0.0.0.0.
KLOXUS_BIND=127.0.0.1
# Postgres connection string — Supabase session pooler in production,
# local Postgres in development. Required in every mode.
# Example: postgres://postgres:password@localhost:5432/kloxus
DATABASE_URL=

# --- Anthropic (triage/draft models; IDs configurable) ---
ANTHROPIC_API_KEY=
KLOXUS_MODEL_TRIAGE=claude-haiku-5-5
KLOXUS_MODEL_DRAFT=claude-sonnet-5-5
# "off" runs the deterministic no-model pipeline (zero API spend):
# triage/storylist become recency+source-diversity ranking and section
# round-robin, dossiers/drafts are assembled from source excerpts, and
# AI-only endpoints answer 409. ANTHROPIC_API_KEY is not needed.
KLOXUS_LLM_MODE=auto
KLOXUS_MAX_DEEP_DIVES=3

# --- Encryption of creators' payment keys (AES-256-GCM) ---
# 32-byte key, base64-encoded. Real mode only; demo generates a git-ignored local key file.
KLOXUS_MASTER_KEY=

# --- Email delivery (real mode) ---
# Sending-only API key — delivery status arrives on /webhooks/resend, so
# the webhook secret below is required for bounce/complaint suppression.
RESEND_API_KEY=
# Full sender with display name on a verified domain.
# Example: Kloxus <news@kloxus-ai.trendfi.com.br>
KLOXUS_FROM_ADDRESS=
# Svix signing secret from the Resend webhook settings (whsec_...).
RESEND_WEBHOOK_SECRET=
# Daily send ceilings — global across every workspace, and per workspace.
KLOXUS_EMAIL_DAILY_CAP=80
KLOXUS_EMAIL_WS_DAILY_CAP=25

# --- Optional: Firecrawl (page monitoring + scrape fallback) ---
FIRECRAWL_API_KEY=
# Public base URL used to build the Firecrawl webhook URL (real mode).
# Example: https://kloxus.example.com — leave empty on localhost (use "Check now" polling).
KLOXUS_PUBLIC_URL=
# Shared secret sent as Authorization: Bearer <secret> on inbound Firecrawl webhooks.
KLOXUS_WEBHOOK_SECRET=

# --- Payments: AbacatePay test mode (creator's own account) ---
ABACATEPAY_API_KEY=
