# Kloxus configuration — real mode only.
# Demo mode (kloxus demo) runs fully offline and needs none of this.
# Copy to .env and fill in. Never commit .env.

# --- Server ---
KLOXUS_PORT=8080
# Interface the HTTP listener binds to. The 127.0.0.1 default keeps local
# dev/test runs off the firewall's radar; the Fly image sets 0.0.0.0.
KLOXUS_BIND=127.0.0.1
# Postgres connection string — Supabase session pooler in production,
# local Postgres in development. Required in every mode.
# Example: postgres://postgres:password@localhost:5432/kloxus
DATABASE_URL=

# --- Anthropic (triage/draft models; IDs configurable) ---
ANTHROPIC_API_KEY=
KLOXUS_MODEL_TRIAGE=claude-haiku-5-5
KLOXUS_MODEL_DRAFT=claude-sonnet-5-5
# "off" runs the deterministic no-model pipeline (zero API spend):
# triage/storylist become recency+source-diversity ranking and section
# round-robin, dossiers/drafts are assembled from source excerpts, and
# AI-only endpoints answer 409. ANTHROPIC_API_KEY is not needed.
KLOXUS_LLM_MODE=auto
KLOXUS_MAX_DEEP_DIVES=3
# --- Spend guards (KLOX-44; all enforced in code before/around the provider) ---
# Max editorial runs per workspace per UTC day.
KLOXUS_RUNS_PER_DAY=2
# Max input+output tokens inside one run.
KLOXUS_TOKENS_PER_RUN=200000
# Max recorded model cost inside one run — the run stops at this.
KLOXUS_LLM_RUN_CAP_USD=0.25
# Max recorded model cost shared by every workspace per UTC day.
KLOXUS_LLM_DAILY_CAP_USD=1.00
# Any non-empty value pauses all model calls immediately.
# KLOXUS_LLM_KILL=1

# --- Encryption of creators' payment keys (AES-256-GCM) ---
# 32-byte key, base64-encoded. Real mode only; demo generates a git-ignored local key file.
KLOXUS_MASTER_KEY=

# --- Email delivery (real mode) ---
# Sending-only API key — delivery status arrives on /webhooks/resend, so
# the webhook secret below is required for bounce/complaint suppression.
RESEND_API_KEY=
# Full sender with display name on a verified domain.
# Example: Kloxus <news@kloxus-ai.trendfi.com.br>
KLOXUS_FROM_ADDRESS=
# Svix signing secret from the Resend webhook settings (whsec_...).
RESEND_WEBHOOK_SECRET=
# Daily send ceilings — global across every workspace, and per workspace.
KLOXUS_EMAIL_DAILY_CAP=80
KLOXUS_EMAIL_WS_DAILY_CAP=25
# Verification/tests only: run live-mail rules against the local fake
# provider (scripts/fake-resend.mjs). Must be a literal loopback http
# URL (no userinfo/path/query/fragment); mutually exclusive with
# RESEND_API_KEY; the client sends a synthetic credential and follows
# no redirects. Never set on a deployed app — invalid values stop the
# process at startup.
# KLOXUS_FAKE_RESEND_URL=http://127.0.0.1:8399
# Set by verification harnesses so an inherited .env cannot leak
# credentials or endpoints into the process.
# KLOXUS_NO_DOTENV=1

# --- Source ingestion (D29: one global poll for all workspaces) ---
# KLOXUS_INGEST=0 disables the whole scheduler. Daily Journal is the
# primary source (KLOX-93) — public API only, hard cap 350 requests/day
# counted per UTC day, RSS feeds stay as coverage fallback.
# KLOXUS_INGEST_DAILY_JOURNAL=0 opts DJ out and polls RSS only.
# The deterministic embedding+classification sweep runs after every
# poll at zero cost; pgvector accelerates it on Supabase but is not
# required (TEXT fallback column otherwise).

# --- Optional: Firecrawl (page monitoring + scrape fallback) ---
FIRECRAWL_API_KEY=
# Public base URL used to build the Firecrawl webhook URL (real mode).
# Example: https://kloxus.example.com — leave empty on localhost (use "Check now" polling).
KLOXUS_PUBLIC_URL=
# Shared secret sent as Authorization: Bearer <secret> on inbound Firecrawl webhooks.
KLOXUS_WEBHOOK_SECRET=
# Max Firecrawl scrapes per workspace per UTC day for the "paste a link"
# proposal flow (one credit each — the paid_actions ledger counts attempts).
KLOXUS_SCRAPES_PER_DAY=5

# --- Payments: AbacatePay test mode (creator's own account) ---
ABACATEPAY_API_KEY=
# Shared secret the AbacatePay dashboard sends on each webhook delivery
# (X-Webhook-Secret header or ?webhookSecret= query). Empty fails the
# /webhooks/abacatepay receiver closed.
ABACATEPAY_WEBHOOK_SECRET=
