# Kloxus configuration — real mode only.
# Demo mode (kloxus demo) runs fully offline and needs none of this.
# Copy to .env and fill in. Never commit .env.

# --- Server ---
KLOXUS_PORT=8080
# Postgres connection string — Supabase session pooler in production,
# local Postgres in development. Required in every mode.
# Example: postgres://postgres:password@localhost:5432/kloxus
DATABASE_URL=

# --- Anthropic (triage/draft models; IDs configurable) ---
ANTHROPIC_API_KEY=
KLOXUS_MODEL_TRIAGE=claude-haiku-5-5
KLOXUS_MODEL_DRAFT=claude-sonnet-5-5
KLOXUS_MAX_DEEP_DIVES=3

# --- Encryption of creators' payment keys (AES-256-GCM) ---
# 32-byte key, base64-encoded. Real mode only; demo generates a git-ignored local key file.
KLOXUS_MASTER_KEY=

# --- Email delivery (real mode) ---
RESEND_API_KEY=
KLOXUS_FROM_ADDRESS=

# --- Optional: Firecrawl (page monitoring + scrape fallback) ---
FIRECRAWL_API_KEY=
# Public base URL used to build the Firecrawl webhook URL (real mode).
# Example: https://kloxus.example.com — leave empty on localhost (use "Check now" polling).
KLOXUS_PUBLIC_URL=
# Shared secret sent as Authorization: Bearer <secret> on inbound Firecrawl webhooks.
KLOXUS_WEBHOOK_SECRET=

# --- Payments: AbacatePay test mode (creator's own account) ---
ABACATEPAY_API_KEY=
